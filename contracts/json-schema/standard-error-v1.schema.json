{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.tool-defect.local/v1/standard-error-v1.schema.json",
  "title": "标准错误对象 v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "message",
    "request_id",
    "trace_id",
    "retryable",
    "details"
  ],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^TD-[A-Z]+-[A-Z]+-[0-9]{3}$"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "request_id": {
      "$ref": "./common-v1.schema.json#/$defs/Uuid"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "retryable": {
      "type": "boolean"
    },
    "details": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "./common-v1.schema.json#/$defs/ErrorDetail"
      }
    }
  }
}
