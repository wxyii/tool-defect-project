{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.tool-defect.local/v1/common-v1.schema.json",
  "title": "刀具缺陷系统 v1 公共契约",
  "$defs": {
    "Uuid": {
      "type": "string",
      "format": "uuid"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "UtcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "Traceparent": {
      "type": "string",
      "pattern": "^00-[a-f0-9]{32}-[a-f0-9]{16}-[a-f0-9]{2}$"
    },
    "CaptureStatus": {
      "type": "string",
      "enum": [
        "CREATED",
        "UPLOADING",
        "READY",
        "SUBMITTED",
        "PROCESSING",
        "REVIEW_PENDING",
        "FINALIZED",
        "FAILED"
      ]
    },
    "LocalQueueStatus": {
      "type": "string",
      "enum": [
        "PENDING",
        "UPLOADING",
        "UPLOADED",
        "SUBMITTED",
        "WAIT_RESULT",
        "DONE",
        "RETRY_WAIT",
        "LOCAL_DEAD"
      ]
    },
    "ExecutionStatus": {
      "type": "string",
      "enum": [
        "QUEUED",
        "RUNNING",
        "SUCCEEDED",
        "RETRY_WAIT",
        "DEAD"
      ]
    },
    "AttemptStatus": {
      "type": "string",
      "enum": [
        "RUNNING",
        "SUCCEEDED",
        "FAILED"
      ]
    },
    "AlgorithmOutcome": {
      "type": "string",
      "enum": [
        "QUALIFIED",
        "UNQUALIFIED",
        "INCONCLUSIVE"
      ]
    },
    "BusinessDisposition": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "HOLD"
      ]
    },
    "ReviewStatus": {
      "type": "string",
      "enum": [
        "PENDING",
        "CLAIMED",
        "SECOND_REVIEW_PENDING",
        "ESCALATED",
        "RESOLVED",
        "CANCELLED"
      ]
    },
    "ObjectState": {
      "type": "string",
      "enum": [
        "STAGING",
        "AVAILABLE",
        "QUARANTINED",
        "DELETED"
      ]
    },
    "ModelStatus": {
      "type": "string",
      "enum": [
        "DRAFT",
        "VALIDATING",
        "APPROVED",
        "SHADOW",
        "CANARY",
        "PRODUCTION",
        "REJECTED",
        "QUARANTINED",
        "RETIRED"
      ]
    },
    "PreprocessQualityStatus": {
      "type": "string",
      "enum": [
        "OK",
        "WARNING",
        "REJECTED"
      ]
    },
    "ImageKind": {
      "type": "string",
      "enum": [
        "RAW",
        "THUMBNAIL",
        "DEFECT_MASK",
        "HEATMAP",
        "OVERLAY",
        "POLAR",
        "REVIEW_MASK"
      ]
    },
    "ObjectReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bucket",
        "object_key",
        "sha256",
        "size_bytes",
        "media_type"
      ],
      "properties": {
        "bucket": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "object_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!https?://)[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "object_version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "media_type": {
          "type": "string",
          "enum": [
            "image/png",
            "image/jpeg",
            "application/json",
            "application/octet-stream"
          ]
        }
      }
    },
    "ImageReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image_id",
        "kind",
        "object",
        "width",
        "height"
      ],
      "properties": {
        "image_id": {
          "$ref": "#/$defs/Uuid"
        },
        "kind": {
          "$ref": "#/$defs/ImageKind"
        },
        "object": {
          "$ref": "#/$defs/ObjectReference"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "image_role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "ErrorDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "reason"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  }
}
