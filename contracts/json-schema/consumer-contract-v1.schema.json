{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.tool-defect.local/v1/consumer-contract-v1.schema.json",
  "title": "消费者契约清单 v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "consumers"],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "consumers": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["consumer_id", "language", "generated_package", "http_operations", "event_operations"],
        "properties": {
          "consumer_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9-]+$"
          },
          "language": {
            "type": "string",
            "enum": ["python", "java", "typescript"]
          },
          "generated_package": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "http_operations": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "event_operations": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      }
    }
  }
}
