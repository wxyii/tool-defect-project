{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.tool-defect.local/v1/state-transition-v1.schema.json",
  "title": "状态转换测试向量 v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "domain",
          "from",
          "to",
          "legal"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "type": "string",
            "enum": [
              "capture",
              "execution",
              "review",
              "object",
              "model"
            ]
          },
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "legal": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
