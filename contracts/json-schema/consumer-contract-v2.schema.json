{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.tool-defect.local/v2/consumer-contract-v2.schema.json",
  "title": "消费者契约清单 v2",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "contract_version", "consumers"],
  "properties": {
    "schema_version": {"const": "2.0"}, "contract_version": {"const": "2.0.0"},
    "consumers": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["consumer_id", "owner", "language", "generated_package", "telemetry_source", "migration_status", "http_operations", "event_operations"],
      "properties": {
        "consumer_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9-]+$"},
        "owner": {"type": "string", "minLength": 1, "maxLength": 128},
        "language": {"type": "string", "enum": ["python", "java", "typescript"]},
        "generated_package": {"type": "string", "minLength": 1, "maxLength": 128},
        "telemetry_source": {"type": "string", "minLength": 1, "maxLength": 256},
        "migration_status": {"type": "string", "enum": ["PLANNED", "TESTING", "ACTIVE", "HOLD", "RETIRED"]},
        "http_operations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "event_operations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
      }
    }}
  }
}
