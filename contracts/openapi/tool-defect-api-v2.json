  "components": {
    "securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"}},
    "parameters": {
      "IdempotencyKey": {"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string", "minLength": 8, "maxLength": 128}},
      "IfMatch": {"name": "If-Match", "in": "header", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 100}},
      "Cursor": {"name": "cursor", "in": "query", "required": false, "schema": {"type": "string", "maxLength": 500}},
      "BatchId": {"name": "batch_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "ItemId": {"name": "item_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "CandidateId": {"name": "candidate_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "ExportJobId": {"name": "export_job_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "UploadId": {"name": "upload_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "ModelVersionId": {"name": "model_version_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "RequestId": {"name": "request_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}
    },
    "schemas": {
      "EmptyCommand": {"type": "object", "additionalProperties": false, "properties": {}},
      "CreateBatchRequest": {"type": "object", "additionalProperties": false, "required": ["usage_stage"], "properties": {"usage_stage": {"$ref": "../json-schema/common-v2.schema.json#/$defs/UsageStage"}, "usage_stage_note": {"type": "string", "maxLength": 200}}},
      "AddItemRequest": {"type": "object", "additionalProperties": false, "required": ["file_name", "size_bytes", "media_type", "sha256"], "properties": {"file_name": {"type": "string", "minLength": 1, "maxLength": 255}, "size_bytes": {"type": "integer", "minimum": 1}, "media_type": {"type": "string", "enum": ["image/jpeg", "image/png"]}, "sha256": {"$ref": "../json-schema/common-v2.schema.json#/$defs/Sha256"}}},
      "CompleteUploadRequest": {"type": "object", "additionalProperties": false, "required": ["sha256", "size_bytes"], "properties": {"sha256": {"$ref": "../json-schema/common-v2.schema.json#/$defs/Sha256"}, "size_bytes": {"type": "integer", "minimum": 1}}},
      "SubmitRequest": {"type": "object", "additionalProperties": false, "required": ["expected_version"], "properties": {"expected_version": {"type": "integer", "minimum": 1}}},
      "QuickReviewRequest": {"type": "object", "additionalProperties": false, "required": ["decision"], "properties": {"decision": {"$ref": "../json-schema/common-v2.schema.json#/$defs/QuickReviewDecision"}, "supersedes_record_id": {"type": "string", "format": "uuid"}}},
      "ProductionItemRequest": {"type": "object", "additionalProperties": false, "required": ["capture_id", "image"], "properties": {"capture_id": {"type": "string", "format": "uuid"}, "image": {"$ref": "../json-schema/common-v2.schema.json#/$defs/ObjectReference"}}},
      "AdminFeedbackRequest": {"type": "object", "additionalProperties": false, "required": ["label"], "properties": {"label": {"$ref": "../json-schema/common-v2.schema.json#/$defs/AdminFeedbackLabel"}, "note": {"type": "string", "maxLength": 2000}, "source_review_record_id": {"type": "string", "format": "uuid"}}},
      "SampleCandidateRequest": {"type": "object", "additionalProperties": false, "required": ["batch_item_id", "feedback_id"], "properties": {"batch_item_id": {"type": "string", "format": "uuid"}, "feedback_id": {"type": "string", "format": "uuid"}}},
      "SampleDecisionRequest": {"type": "object", "additionalProperties": false, "required": ["decision"], "properties": {"decision": {"type": "string", "enum": ["INCLUDE", "EXCLUDE"]}, "note": {"type": "string", "maxLength": 1000}}},
      "SampleExportRequest": {"type": "object", "additionalProperties": false, "required": ["candidate_ids"], "properties": {"candidate_ids": {"type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": {"type": "string", "format": "uuid"}}, "filter_snapshot": {"type": "object", "additionalProperties": {"type": "string"}}}},
      "ModelUploadRequest": {"type": "object", "additionalProperties": false, "required": ["model_version", "size_bytes", "sha256"], "properties": {"model_version": {"type": "string", "minLength": 1, "maxLength": 100}, "size_bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "../json-schema/common-v2.schema.json#/$defs/Sha256"}, "description": {"type": "string", "maxLength": 1000}}},
      "ActivationRequest": {"type": "object", "additionalProperties": false, "required": ["rollback_model_version_id", "reason"], "properties": {"rollback_model_version_id": {"type": "string", "format": "uuid"}, "reason": {"type": "string", "minLength": 1, "maxLength": 1000}}},
      "ApprovalRequest": {"type": "object", "additionalProperties": false, "required": ["approval_note"], "properties": {"approval_note": {"type": "string", "minLength": 1, "maxLength": 1000}}},
      "ModelHistoryItem": {"type": "object", "additionalProperties": false, "required": ["model_version_id", "version", "validation_status"], "properties": {"model_version_id": {"type": "string", "format": "uuid"}, "version": {"type": "string"}, "validation_status": {"$ref": "../json-schema/common-v2.schema.json#/$defs/ModelValidationStatus"}, "legacy_provenance": {"$ref": "../json-schema/common-v2.schema.json#/$defs/LegacyProvenanceSnapshot"}}},
      "StandardError": {"$ref": "../json-schema/common-v2.schema.json#/$defs/StandardError"}
    },
    "responses": {
      "JsonSuccess": {"description": "成功", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": true}}}},
      "ModelHistorySuccess": {"description": "模型历史", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["items"], "properties": {"items": {"type": "array", "items": {"$ref": "#/components/schemas/ModelHistoryItem"}}}}}}},
      "Error": {"description": "失败", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/StandardError"}}}},
      "Retired": {"description": "旧能力已退役；不得创建任务", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/StandardError"}, "example": {"error_code": "TD-LEGACY-FEATURE-RETIRED", "message": "该第一版写能力已退役", "request_id": "00000000-0000-4000-8000-000000000001", "retryable": false}}}}
    }
  }
}
